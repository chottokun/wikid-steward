# ==============================================================================
# Environment Variable Overrides for wikid-steward (Example Configuration)
# Copy this file to .env and adjust your secrets / local settings
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM (OpenAI Compatible API) Configuration
# ------------------------------------------------------------------------------
# Select provider (e.g., "ollama", "openai", "anthropic", "custom")
LLM_PROVIDER="ollama"

# Base URL of LLM API. (Fallbacks to OPENAI_BASE_URL if unset)
LLM_BASE_URL="http://localhost:11434/v1"
OPENAI_BASE_URL="http://localhost:11434/v1"

# API Key / Secret Key for LLM. KEEP THIS SECRET! (Fallbacks to OPENAI_API_KEY if unset)
LLM_API_KEY="your-llm-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"

# LLM model identifier. (Fallbacks to OPENAI_MODEL if unset)
LLM_MODEL="gemma4:latest"
OPENAI_MODEL="gemma4:latest"

# LLM sampling temperature and response generation options
LLM_TEMPERATURE="0.2"
LLM_MAX_TOKENS="2048"


# ------------------------------------------------------------------------------
# VLM (Vision Language Model) Configuration
# ------------------------------------------------------------------------------
VLM_ENABLED="true"
VLM_PROVIDER="ollama"
VLM_MODEL="qwen3.5:4b"
VLM_ENDPOINT="http://localhost:11434"

# API Key / Secret Key for VLM if using cloud-based vision APIs (e.g., OpenAI, Anthropic). KEEP THIS SECRET!
VLM_API_KEY="your-vlm-api-key-here"

VLM_PROMPT="この画像の概要を1〜2文程度で簡潔に日本語で説明してください。"


# ------------------------------------------------------------------------------
# Paths & Directory Configurations
# ------------------------------------------------------------------------------
RAW_DIR="_raw"
RAW_SOURCES_DIR="raw_sources"
STAGING_DIR="staging"
WIKI_DIR="wiki"


# ------------------------------------------------------------------------------
# Relinker & Glossary Settings
# ------------------------------------------------------------------------------
# Comma-separated list of words to exclude from auto-linking
RELINKER_STOP_WORDS="AI,NLP,LLM,LLMS,DATA,OUTPUT,FILE,PDF,PAPER,MODEL,SYSTEM"
RELINKER_MIN_TERM_LENGTH="3"


# ------------------------------------------------------------------------------
# Vector DB (Qdrant) & Embeddings Configuration
# ------------------------------------------------------------------------------
VECTOR_DB_PROVIDER="qdrant"

# URL of Qdrant instance (e.g., http://localhost:6333, :memory:, or path to local DB)
VECTOR_DB_URL="http://localhost:6333"

# API Key / Token for Qdrant Cloud or protected instances. KEEP THIS SECRET!
VECTOR_DB_API_KEY="your-qdrant-api-key-here"

VECTOR_DB_COLLECTION_NAME="wikid_steward_knowledge"
VECTOR_DB_MAX_CONTEXT_TOKENS="4000"

# Embeddings Engine configuration
VECTOR_DB_EMBEDDING_PROVIDER="ollama"
VECTOR_DB_EMBEDDING_BASE_URL="http://localhost:11434/v1"
VECTOR_DB_EMBEDDING_MODEL="qwen3-embedding:0.6b"

# API Key for Embedding generator if using cloud embedding services (e.g., OpenAI). KEEP THIS SECRET!
VECTOR_DB_EMBEDDING_API_KEY="your-embedding-api-key-here"

# Traversal Graph constraints
VECTOR_DB_MAX_HUB_DEGREE="25"
VECTOR_DB_MAX_TRAVERSAL_TOKENS="1200"
